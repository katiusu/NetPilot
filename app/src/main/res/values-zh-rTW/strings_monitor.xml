    <!-- 4. 阈值一览（只读；值来自内核真正生效的 DowngradeThresholds） -->
    <string name="monitor_section_thresholds">當前閾值（只讀）</string>
    <string name="monitor_threshold_hint">要改這些數請去「功能」頁的「網路質量自動降級」卡片；這裡只顯示核心此刻真正在用的值</string>
    <string name="monitor_threshold_rsrp">RSRP 強訊號閾值</string>
    <string name="monitor_threshold_rsrp_summary">單位 dBm；RSRP 嚴格高於該值才算「強訊號」，才可能命中「假滿格」規則</string>
    <string name="monitor_threshold_sinr">SINR 下限</string>
    <string name="monitor_threshold_sinr_summary">單位 dB；在「訊號強」的前提下，SINR 低於該值即算質量差。讀不到 SINR 時這一條不生效，判定改用 Ping</string>
    <string name="monitor_threshold_ping">Ping 上限</string>
    <string name="monitor_threshold_ping_summary">單位 ms；在「訊號強」的前提下，Ping 高於該值即算質量差</string>
    <string name="monitor_threshold_weak_signal">訊號過差也觸發降級</string>
    <string name="monitor_threshold_weak_signal_summary">關：弱訊號只記錄、不動制式；開：RSRP 低於下面的弱訊號閾值時把 5G 換成更穩的 4G</string>
    <string name="monitor_threshold_weak_rsrp">RSRP 弱訊號閾值</string>
    <string name="monitor_threshold_weak_rsrp_summary">單位 dBm；RSRP 低於該值即命中「訊號過差」，與 Ping、SINR 無關</string>
    <string name="monitor_threshold_cooldown">降級後冷卻時長</string>
    <string name="monitor_threshold_cooldown_summary">單位 秒；降級後這段時間內不做任何恢復嘗試，避免剛切到 4G 又立刻彈回 5G</string>
    <string name="monitor_threshold_recovery">恢復所需連續正常輪數</string>
    <string name="monitor_threshold_recovery_summary">單位 輪；冷卻結束後需要連續這麼多輪判定為正常才恢復，單輪正常可能只是抖動</string>
    <string name="monitor_threshold_rollback">無網回退閾值</string>
    <string name="monitor_threshold_rollback_summary">單位 輪；降級態下連續這麼多輪無網或無響應，就整體回退到完整制式</string>
    <string name="monitor_threshold_interval">常規取樣間隔</string>
    <string name="monitor_threshold_interval_summary">單位 秒；前臺服務每隔這麼久取樣一次（開啟監控頁時會臨時加快到 5 秒）</string>
    <string name="monitor_threshold_downgrade">降級目標制式</string>
    <string name="monitor_threshold_downgrade_summary">命中規則後寫入的制式；預設 9 = LTE/GSM/WCDMA，保留 3G 回退</string>
    <string name="monitor_threshold_lock_lte">鎖定 LTE 時用的制式</string>
    <string name="monitor_threshold_lock_lte_summary">恢復與回退時寫回的制式；「跟隨運營商」= 按 SIM 卡 MCC/MNC 推導的 5G 自動</string>
    <string name="monitor_threshold_ping_fail">Ping 完全失敗也算網路質量差</string>
    <string name="monitor_threshold_ping_fail_summary">關：Ping 全失敗只記日誌、不降級；開：Ping 全失敗與「Ping 超上限」一視同仁，同樣觸發降級</string>
    <string name="monitor_threshold_endc">降級時同時關閉 EN-DC</string>
    <string name="monitor_threshold_endc_summary">開：降級與恢復時額外寫 endc_capability；部分機型必須關掉 NSA 雙連線才能真正落到 4G</string>

