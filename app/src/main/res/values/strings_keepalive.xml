<?xml version="1.0" encoding="utf-8"?>
<!--
  后台服务（保活 / 总开关）与系统兼容性的文案，key 统一 ka_ 前缀。

  分成独立文件的原因和 strings_monitor.xml 一样：这块功能由一个开发者独立负责，
  单独成文件可以避免和其他分支并发改 strings.xml 时产生冲突。

  写作约定：开关的 summary 只写「改了什么 / 默认值 / 最要紧的后果」，长解释放 *_hint
  脚注（脚注一定会换行，summary 有被截断的风险）。系统兼容性里的每一项都必须是真测出来
  的值，测不到就显示「未知」——「未知」表示没测到，不表示没问题。
-->
<resources>

    <!-- ===================== 后台服务总开关 ===================== -->
    <string name="ka_section_services">后台服务</string>
    <string name="ka_gate_title">启用所有后台服务</string>
    <string name="ka_gate_summary">默认开启，是后台行为的总闸。关闭会停掉监控前台服务、心跳、被杀重启、开机自启，Tasker 和磁贴触发的操作也失效。</string>
    <string name="ka_gate_hint">开启：登记心跳、开机自启、被杀重启，Tasker 与磁贴生效；监控需自动降级开着才拉起。关闭：监控与心跳即停，不再自启重启。</string>
    <string name="ka_status_title">运行状态</string>
    <string name="ka_status_summary">监控服务：%1$s · 保活心跳：%2$s</string>
    <string name="ka_status_running">运行中</string>
    <string name="ka_status_stopped">已停止</string>
    <string name="ka_heartbeat_on">已注册</string>
    <string name="ka_heartbeat_off">未注册</string>
    <string name="ka_status_hint">心跳走系统闹钟，息屏或省电时可能迟到几分钟。显示「已停止」时点上面开关重新拉起；但通知栏点过「停止」后不会再自动拉起。</string>

    <!-- ===================== 系统兼容性 ===================== -->
    <string name="ka_section_compat">系统兼容性</string>
    <string name="ka_verify_title">写入后回读校验</string>
    <string name="ka_verify_summary">默认开启。开启：写完 settings 立刻读回比对，不一致算失败并写日志。关闭：写一次就当成功，不再比对。</string>
    <string name="ka_verify_hint">只在「写入生效却误报失败」时才关：部分厂商 ROM 回读不准，会把成功判成失败。关掉后只能自己到系统设置核对，失败不再进日志。</string>
    <string name="ka_verbose_title">详细日志模式</string>
    <string name="ka_verbose_summary">默认关闭 = 简要模式：只记结论、失败原因，以及失败时系统返回的原始值（退出码、原始输出、异常原文）。开启 = 详细模式：连每一步的原始输出、逐次尝试过程都记进日志页。</string>
    <string name="ka_verbose_hint">先看简要模式；排查「开关拨了但网络没变」时再开详细模式。root 通道下详细诊断要从 app_process 子进程搬回应用进程，开启会有额外开销，问题查完请关掉。</string>

    <string name="ka_compat_vendor">厂商</string>
    <string name="ka_compat_model">型号</string>
    <string name="ka_compat_brand">品牌</string>
    <string name="ka_compat_android">Android 版本</string>
    <string name="ka_compat_miui">系统构建版本</string>

    <string name="ka_compat_channel">当前特权通道</string>
