    <!-- 功能页配置项 -->
    <string name="np_fake5g_enabled_title">启用网络质量降级</string>
    <string name="np_fake5g_enabled_summary">总开关（默认开）。开：命中「假满格」或「信号过差」就自动把 5G 换成 4G；关：只采样记日志，不改网络制式</string>
    <string name="np_fake5g_rsrp_title">RSRP 强信号阈值</string>
    <string name="np_fake5g_rsrp_summary">单位 dBm（默认 -85）。RSRP 高于它才算「信号强」，才可能命中假满格；数值越大越苛刻，越难触发降级</string>
    <string name="np_fake5g_sinr_title">SINR 质量阈值</string>
    <string name="np_fake5g_sinr_summary">单位 dB（默认 0）。仅当信号强时才看它：SINR 低于它算质量差，数值越大越严格；读不到 SINR 时这条不生效，改用 Ping</string>
    <string name="np_fake5g_ping_title">Ping 上限</string>
    <string name="np_fake5g_ping_summary">单位 ms（默认 200）。仅当信号强时才看它：Ping 高于它算质量差，数值越小越严格、越容易触发降级</string>
    <string name="np_fake5g_ping_fail_title">Ping 失败也算差</string>
    <string name="np_fake5g_ping_fail_summary">默认关。开：Ping 全部失败也按质量差处理、照样降级；关：只记日志不降级。经常整片探测不通才建议开</string>
    <string name="np_fake5g_weak_signal_title">信号过差也降级</string>
    <string name="np_fake5g_weak_signal_summary">默认开。开：RSRP 低于下面的弱信号阈值就换 4G；关：弱信号只记录，不改制式</string>
    <string name="np_fake5g_weak_rsrp_title">RSRP 弱信号阈值</string>
    <string name="np_fake5g_weak_rsrp_summary">单位 dBm（默认 -110）。RSRP 低于它即算信号过差，与 Ping、SINR 无关；上面的开关打开才生效，数值越大越容易降级</string>
    <string name="np_fake5g_endc_title">降级时关闭 EN-DC</string>
    <string name="np_fake5g_endc_summary">默认关。开：降级和恢复时额外关闭 EN-DC（NSA 双连接），部分机型才能真正落到 4G；不确定就别开</string>
    <string name="np_fake5g_downgrade_mode_title">降级目标制式</string>
    <string name="np_fake5g_downgrade_mode_summary">默认「4G 优先」。命中规则时写入的制式；选「仅 4G」更彻底，但丢了 3G 回退，信号差的地方可能直接无网</string>
    <string name="np_fake5g_lock_lte_mode_title">恢复目标制式</string>
    <string name="np_fake5g_lock_lte_mode_summary">默认「跟随运营商」。冷却结束恢复时写回的制式，按 SIM 卡自动推导出 5G 自动，换卡不用改；乱选可能恢复后上不了 5G</string>
    <string name="np_fake5g_cooldown_title">降级冷却时间</string>
    <string name="np_fake5g_cooldown_summary">单位 秒（默认 60 = 1 分钟）。降级后这么久内不尝试恢复，免得刚切到 4G 又立刻弹回 5G；调大更省电，但 5G 回来更慢</string>
    <string name="np_fake5g_recovery_title">恢复所需正常轮数</string>
    <string name="np_fake5g_recovery_summary">单位 轮（默认 2）。冷却结束后要连续这么多轮正常才恢复；调大更稳但更慢，调成 1 会被单次抖动骗回 5G</string>
    <string name="np_fake5g_no_net_rollback_title">无网回退阈值</string>
    <string name="np_fake5g_no_net_rollback_summary">单位 轮（默认 2）。降级后连续这么多轮完全无网就整体回退到完整制式；调小自救更快，调大容易一直卡在无网</string>
    <string name="np_fake5g_interval_title">采样间隔</string>
    <string name="np_fake5g_interval_summary">单位 秒（默认 60）。前台服务每隔这么久采一次，越大越省电、反应越慢；打开监控页会临时加快到 5 秒</string>
    <string name="np_monitor_autostart_title">开机自动启动监控</string>
    <string name="np_monitor_autostart_summary">重启后自动恢复监控与降级状态</string>
