    <!-- 4. 阈值一览（只读；值来自内核真正生效的 DowngradeThresholds） -->
    <string name="monitor_section_thresholds">当前阈值（只读）</string>
    <string name="monitor_threshold_hint">要改这些数请去「功能」页的「网络质量自动降级」卡片；这里只显示内核此刻真正在用的值</string>
    <string name="monitor_threshold_rsrp">RSRP 强信号阈值</string>
    <string name="monitor_threshold_rsrp_summary">单位 dBm；RSRP 严格高于该值才算「强信号」，才可能命中「假满格」规则</string>
    <string name="monitor_threshold_sinr">SINR 下限</string>
    <string name="monitor_threshold_sinr_summary">单位 dB；在「信号强」的前提下，SINR 低于该值即算质量差。读不到 SINR 时这一条不生效，判定改用 Ping</string>
    <string name="monitor_threshold_ping">Ping 上限</string>
    <string name="monitor_threshold_ping_summary">单位 ms；在「信号强」的前提下，Ping 高于该值即算质量差</string>
    <string name="monitor_threshold_weak_signal">信号过差也触发降级</string>
    <string name="monitor_threshold_weak_signal_summary">关：弱信号只记录、不动制式；开：RSRP 低于下面的弱信号阈值时把 5G 换成更稳的 4G</string>
    <string name="monitor_threshold_weak_rsrp">RSRP 弱信号阈值</string>
    <string name="monitor_threshold_weak_rsrp_summary">单位 dBm；RSRP 低于该值即命中「信号过差」，与 Ping、SINR 无关</string>
    <string name="monitor_threshold_cooldown">降级后冷却时长</string>
    <string name="monitor_threshold_cooldown_summary">单位 秒；降级后这段时间内不做任何恢复尝试，避免刚切到 4G 又立刻弹回 5G</string>
    <string name="monitor_threshold_recovery">恢复所需连续正常轮数</string>
    <string name="monitor_threshold_recovery_summary">单位 轮；冷却结束后需要连续这么多轮判定为正常才恢复，单轮正常可能只是抖动</string>
    <string name="monitor_threshold_rollback">无网回退阈值</string>
    <string name="monitor_threshold_rollback_summary">单位 轮；降级态下连续这么多轮无网或无响应，就整体回退到完整制式</string>
    <string name="monitor_threshold_interval">常规采样间隔</string>
    <string name="monitor_threshold_interval_summary">单位 秒；前台服务每隔这么久采样一次（打开监控页时会临时加快到 5 秒）</string>
    <string name="monitor_threshold_downgrade">降级目标制式</string>
    <string name="monitor_threshold_downgrade_summary">命中规则后写入的制式；默认 9 = LTE/GSM/WCDMA，保留 3G 回退</string>
    <string name="monitor_threshold_lock_lte">锁定 LTE 时用的制式</string>
    <string name="monitor_threshold_lock_lte_summary">恢复与回退时写回的制式；「跟随运营商」= 按 SIM 卡 MCC/MNC 推导的 5G 自动</string>
    <string name="monitor_threshold_ping_fail">Ping 完全失败也算网络质量差</string>
    <string name="monitor_threshold_ping_fail_summary">关：Ping 全失败只记日志、不降级；开：Ping 全失败与「Ping 超上限」一视同仁，同样触发降级</string>
    <string name="monitor_threshold_endc">降级时同时关闭 EN-DC</string>
    <string name="monitor_threshold_endc_summary">开：降级与恢复时额外写 endc_capability；部分机型必须关掉 NSA 双连接才能真正落到 4G</string>

